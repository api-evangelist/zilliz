{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zilliz Cloud Clusters API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Clusters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List clusters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.zilliz.com/v2/clusters",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Records per page."
              },
              {
                "name": "currentPage",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)."
              },
              {
                "name": "region",
                "value": "",
                "type": "query",
                "description": "Filter by cloud region."
              }
            ]
          },
          "docs": "List clusters"
        },
        {
          "info": {
            "name": "Create a Serverless cluster",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.zilliz.com/v2/clusters/createServerless",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a Serverless cluster"
        },
        {
          "info": {
            "name": "Create a Dedicated cluster",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.zilliz.com/v2/clusters/createDedicated",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a Dedicated cluster"
        },
        {
          "info": {
            "name": "Describe a cluster",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.zilliz.com/v2/clusters/:clusterId",
            "params": [
              {
                "name": "clusterId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Describe a cluster"
        },
        {
          "info": {
            "name": "Drop a cluster",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.cloud.zilliz.com/v2/clusters/:clusterId",
            "params": [
              {
                "name": "clusterId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Drop a cluster"
        },
        {
          "info": {
            "name": "Suspend a cluster",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.zilliz.com/v2/clusters/:clusterId/suspend",
            "params": [
              {
                "name": "clusterId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Suspend a cluster"
        },
        {
          "info": {
            "name": "Resume a suspended cluster",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.zilliz.com/v2/clusters/:clusterId/resume",
            "params": [
              {
                "name": "clusterId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Resume a suspended cluster"
        }
      ]
    }
  ],
  "bundled": true
}