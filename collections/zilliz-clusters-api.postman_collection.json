  "info": {
    "_postman_id": "24b722ba-a73b-4ebe-9df8-f7b1b82f39c9",
    "name": "Zilliz Cloud Clusters API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Zilliz Cloud exposes two HTTP API surfaces, both documented at\ndocs.zilliz.com/reference/restful. The Control Plane API (hosted at\napi.cloud.zilliz.com/v2) is used by account owners and operators to manage\nclusters, users, and roles. The Data Plane API (hosted at the\nper-cluster vectordb.zillizcloud.com endpoint) is used by applications to\ncreate collections and read or write vector data. Both surfaces are\nauthenticated with a Bearer API key.\n\nContact Support:\n Name: Zilliz Documentation",
      "type": "text/plain"
    }
  }
