{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zilliz Cloud Cloud Providers API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cloud Providers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List supported cloud providers and regions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.zilliz.com/v2/clouds"
          },
          "docs": "List supported cloud providers and regions"
        }
      ]
    }
  ],
  "bundled": true
}